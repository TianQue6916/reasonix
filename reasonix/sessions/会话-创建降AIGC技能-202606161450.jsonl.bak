", \\\"故而\\\", \\\"所以\\\"],\\n    \\\"所以\\\": [\\\"因此可以说\\\", \\\"因而\\\", \\\"故而\\\"],\\n    \\\"因为\\\": [\\\"主要是由于\\\", \\\"主要是因为\\\", \\\"原因在于\\\"],\\n    \\\"由于\\\": [\\\"因为\\\", \\\"出于\\\", \\\"鉴于\\\"],\\n    \\\"而且\\\": [\\\"同时\\\", \\\"并且\\\", \\\"除此之外\\\"],\\n    \\\"但是\\\": [\\\"不过\\\", \\\"可是\\\", \\\"然而\\\"],\\n    \\\"然而\\\": [\\\"不过\\\", \\\"但是\\\", \\\"可是\\\"],\\n    \\\"如果\\\": [\\\"假如\\\", \\\"倘若\\\", \\\"要是\\\"],\\n    \\\"首先\\\": [\\\"第一\\\", \\\"第一点\\\", \\\"其一\\\"],\\n    \\\"其次\\\": [\\\"第二\\\", \\\"第二点\\\", \\\"其二\\\"],\\n    \\\"最后\\\": [\\\"第三\\\", \\\"第三点\\\", \\\"最终\\\"],\\n    \\\"一方面\\\": [\\\"一来\\\", \\\"首先\\\"],\\n    \\\"另一方面\\\": [\\\"二来\\\", \\\"其次\\\"]\\n  },\\n  \\\"common_words\\\": {\\n    \\\"重要\\\": [\\\"关键\\\", \\\"核心\\\", \\\"要紧\\\"],\\n    \\\"研究\\\": [\\\"探讨\\\", \\\"考察\\\", \\\"探究\\\"],\\n    \\\"分析\\\": [\\\"解析\\\", \\\"梳理\\\", \\\"研判\\\"],\\n    \\\"方法\\\": [\\\"办法\\\", \\\"途径\\\", \\\"手段\\\"],\\n    \\\"问题\\\": [\\\"议题\\\", \\\"课题\\\", \\\"事项\\\"],\\n    \\\"影响\\\": [\\\"作用\\\", \\\"效应\\\", \\\"冲击\\\"],\\n    \\\"发展\\\": [\\\"进展\\\", \\\"推进\\\", \\\"演变\\\"],\\n    \\\"系统\\\": [\\\"体系\\\", \\\"框架\\\"],\\n    \\\"方面\\\": [\\\"层面\\\", \\\"维度\\\"],\\n    \\\"特点\\\": [\\\"特征\\\", \\\"属性\\\"],\\n    \\\"过程\\\": [\\\"进程\\\", \\\"经过\\\"],\\n    \\\"结果\\\": [\\\"成果\\\", \\\"成效\\\"],\\n    \\\"条件\\\": [\\\"前提\\\", \\\"基础\\\"],\\n    \\\"内容\\\": [\\\"要素\\\", \\\"构成\\\"],\\n    \\\"程度\\\": [\\\"幅度\\\", \\\"力度\\\"],\\n    \\\"目标\\\": [\\\"目的\\\", \\\"方向\\\"],\\n    \\\"范围\\\": [\\\"领域\\\", \\\"范畴\\\"],\\n    \\\"趋势\\\": [\\\"走向\\\", \\\"态势\\\"],\\n    \\\"能力\\\": [\\\"实力\\\", \\\"水平\\\"],\\n    \\\"环境\\\": [\\\"条件\\\", \\\"背景\\\"],\\n    \\\"需要\\\": [\\\"有必要\\\", \\\"应当\\\"],\\n    \\\"通过\\\": [\\\"借助\\\", \\\"经由\\\"],\\n    \\\"根据\\\": [\\\"依照\\\", \\\"按照\\\"],\\n    \\\"目前\\\": [\\\"当前\\\", \\\"现阶段\\\"],\\n    \\\"主要\\\": [\\\"核心\\\", \\\"关键\\\"],\\n    \\\"一般\\\": [\\\"通常\\\", \\\"普遍\\\"],\\n    \\\"大量\\\": [\\\"大批\\\", \\\"众多\\\"],\\n    \\\"可能\\\": [\\\"或许\\\", \\\"也许\\\"],\\n    \\\"显著\\\": [\\\"突出\\\", \\\"明显\\\"],\\n    \\\"广泛\\\": [\\\"普遍\\\", \\\"多方\\\"],\\n    \\\"日益\\\": [\\\"日渐\\\", \\\"越来越\\\"],\\n    \\\"非常\\\": [\\\"相当\\\", \\\"十分\\\"],\\n    \\\"很多\\\": [\\\"不少\\\", \\\"诸多\\\"],\\n    \\\"比较\\\": [\\\"较为\\\", \\\"相对\\\"],\\n    \\\"同时\\\": (\\\"并且\\\", \\\"与此同步\\\"),\\n    \\\"导致\\\": [\\\"引发\\\", \\\"带来\\\"],\\n    \\\"产生\\\": [\\\"形成\\\", \\\"出现\\\"],\\n    \\\"提高\\\": [\\\"提升\\\", \\\"增加\\\"],\\n    \\\"降低\\\": [\\\"减少\\\", \\\"下降\\\"],\\n    \\\"建立\\\": [\\\"构建\\\", \\\"设立\\\"],\\n    \\\"实现\\\": [\\\"达成\\\", \\\"完成\\\"],\\n    \\\"支持\\\": [\\\"支撑\\\", \\\"推动\\\"],\\n    \\\"包括\\\": [\\\"涵盖\\\", \\\"包含\\\"]\\n  }\\n}\\n\", \"path\": \"C:\\\\Users\\\\27063\\\\Desktop\\\\工具箱\\\\aigc-engine\\\\rules\\\\replacement_rules.json\"}"}}],"reasoning_content":"Good, detector is done. Now let me build the rules database."}
