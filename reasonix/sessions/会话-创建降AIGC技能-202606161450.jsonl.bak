{"role":"tool","tool_call_id":"call_00_aCezH4sYR281yFDpePBY0310","name":"run_command","content":"$ python -c \"\n# Quick test detector first\nimport sys\nsys.path.insert(0, r'C:\\Users\\27063\\Desktop\\工具箱\\aigc-engine')\nfrom detector import AIGCDetector\n\npath = r'C:\\Users\\27063\\Desktop\\工具箱\\论文降低aigc分析文献库\\全球治理视域下的变局与共识_v3（v9.1策略）.txt'\nwith open(path, 'r', encoding='utf-8') as f:\n    text = f.read()\n\nd = AIGCDetector()\nr = d.get_report(text)\nprint(f'综合评分: {r[\\\"total\\\"]:.1f}/100 — {r[\\\"level\\\"]}')\nprint('维度:')\nfor k,v in r['details'].items():\n    print(f'  {k}: {v:.1f}')\n\"\n[exit 0]\n综合评分: 36.5/100 — 🟣 LOW\r\n维度:\r\n  ngram: 25.0\r\n  sentence_length: 20.0\r\n  vocabulary: 25.0\r\n  punctuation: 55.0\r\n  ai_words: 70.0\r\n  paragraph: 30.0\r\n"}
