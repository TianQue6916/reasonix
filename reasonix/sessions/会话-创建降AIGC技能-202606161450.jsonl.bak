{"role":"assistant","content":"","tool_calls":[{"id":"call_00_lQXQMZSVBGREOB00j2uZ3725","type":"function","function":{"name":"write_file","arguments":"{\"content\": \"\\\"\\\"\\\"\\nAI文本自我审计迭代管线\\n基于：NeurIPS 2025 Adversarial Paraphrasing + humanizer-skill 43模式 + humanize-text 回译链\\n思路：多轮自我审计 → 发现问题 → 针对性修复 → 重新审计 → 循环\\n\\\"\\\"\\\"\\n\\nimport re\\n\\nclass SelfAuditPipeline:\\n    def __init__(self, text):\\n        self.text = text\\n        self.issues = []\\n    \\n    def count_pattern(self, pattern, name):\\n        matches = len(re.findall(pattern, self.text))\\n        if matches > 0:\\n            self.issues.append((name, matches, pattern))\\n        return matches\\n    \\n    def audit(self):\\n        \\\"\\\"\\\"审计文本，找出所有AI模式\\\"\\\"\\\"\\n        self.issues = []\\n        \\n        # 模式1: 破折号过多\\n        self.count_pattern(r'——', '破折号过多')\\n        \\n        # 模式2: 三连结构 \\\"A、B和C\\\"\\n        self.count_pattern(r'[、，,]\\\\s*[^。；;]{2,10}[、，,]\\\\s*[^。；;]{2,10}和', '三连排比结构')\\n        \\n        # 模式3: \\\"首先/其次/最后\\\" \\n        self.count_pattern(r'首先[，,]|其次[，,]|最后[，,]', '序列词模板')\\n        \\n        # 模式4: \\\"不仅...而且...\\\"\\n        self.count_pattern(r'不仅[^。]{3,10}而且[^。]{3,10}', '不仅而且模板')\\n        \\n        # 模式5: \\\"一方面...另一方面...\\\"\\n        self.count_pattern(r'一方面[^。]{3,15}另一方面', '一方面另一方面模板')\\n        \\n        # 模式6: 总结词\\n        self.count_pattern(r'综上所述|总而言之|总的来说|总体来看', '总结词模板')\\n        \\n        # 模式7: \\\"毫无疑问/不可否认/显而易见\\\"\\n        self.count_pattern(r'毫无疑问|不可否认|显而易见|毋庸置疑', '绝对判断词')\\n        \\n        # 模式8: 句长均匀度检查（连续3句长度相近）\\n        self._check_sentence_uniformity()\\n        \\n        # 模式9: \\\"具有重要意义/发挥着重要作用\\\"\\n        self.count_pattern(r'重要意义|重要作用|关键作用|不可替代', '空洞大词')\\n        \\n        # 模式10: \\\"未来展望/前景广阔\\\"\\n        self.count_pattern(r'前景广阔|未来展望|任重道远|意义重大', '空洞展望')\\n        \\n        # 模式11: \\\"导致/引起/造成\\\" 使用频率\\n        self.count_pattern(r'导致|引起|造成|促使', '因果词频率')\\n        \\n        # 模式12: 每段开头重复模式\\n        self._check_paragraph_openings()\\n        \\n        return self.issues\\n    \\n    def _check_sentence_uniformity(self):\\n        \\\"\\\"\\\"检查是否有三句以上长度相近的连续句子\\\"\\\"\\\"\\n        sents = []\\n        for s in re.split(r'[。！？]', self.text):\\n            c = len(re.findall(r'[\\\\u4e00-\\\\u9fff]', s.strip()))\\n            if c >= 8:\\n                sents.append(c)\\n        \\n        uniform_count = 0\\n        for i in range(len(sents) - 2):\\n            a, b, c = sents[i], sents[i+1], sents[i+2]\\n            if abs(a-b) <= 5 and abs(b-c) <= 5 and abs(a-c) <= 8:\\n                uniform_count += 1\\n        \\n        if uniform_count >= 3:\\n            self.issues.append(('句长过于均匀', uniform_count, 'sentence_uniformity'))\\n    \\n    def _check_paragraph_openings(self):\\n        \\\"\\\"\\\"检查段落开头是否重复\\\"\\\"\\\"\\n        paragraphs = [p.strip() for p in self.text.split('\\\\n') if len(p.strip()) > 20]\\n        openings = []\\n        for p in paragraphs:\\n            first_20 = p[:20] if len(p) >= 20 else p\\n            openings.append(first_20)\\n        \\n        unique = len(set(openings))\\n        if len(openings) >= 5 and unique < len(openings) * 0.7:\\n            self.issues.append(('段落开头重复率过高', len(openings) - unique, 'paragraph_openings'))\\n    \\n    def fix_em_dashes(self):\\n        \\\"\\\"\\\"修复破折号：保留一部分，替换一部分为逗号\\\"\\\"\\\"\\n        count = self.text.count('——')\\n        if count > 30:\\n            parts = self.text.split('——')\\n            result = [parts[0]]\\n            for i in range(1, len(parts)):\\n                if i % 3 == 0:\\n                    result.append('——' + parts[i])\\n                else:\\n                    result.append('，' + parts[i])\\n            self.text = ''.join(result)\\n            return True\\n        return False\\n    \\n    def fix_template_connectors(self):\\n        \\\"\\\"\\\"修复模板化连接词\\\"\\\"\\\"\\n        fixes = {\\n            '首先，': '一开始，',\\n            '其次，': '接着，',\\n            '最后，': '到了最后，',\\n            '首先': '', '其次': '', '最后': '',\\n            '综上所述': '', '总而言之': '', '总的来说': '',\\n            '毫无疑问': '', '显而易见': '',\\n            '具有重要意义': '',\\n            '发挥着重要作用': '',\\n        }\\n        changed = False\\n        for old, new in fixes.items():\\n            if old in self.text and new == '':\\n                self.text = self.text.replace(old, new)\\n                changed = True\\n            elif old in self.text:\\n                self.text = self.text.replace(old, new)\\n                changed = True\\n        return changed\\n    \\n    def randomize_sentence_openings(self):\\n        \\\"\\\"\\\"随机化句子开头\\\"\\\"\\\"\\n        # 替换\\\"这\\\"开头的句子\\n        self.text = re.sub(r'(?<=[。！？])这', ' 这', self.text)\\n        # 这个比较保守,先跳过\\n        return False\\n    \\n    def fix_absolutes(self):\\n        \\\"\\\"\\\"降低绝对化表达\\\"\\\"\\\"\\n        fixes = {\\n            '必然': '很可能',\\n            '一定会': '大概率会',\\n            '必将': '有望',\\n            '绝对': '在很大程度',\\n            '无一例外': '在绝大多数情况',\\n        }\\n        changed = False\\n        for old, new in fixes.items():\\n            if old in self.text:\\n                self.text = self.text.replace(old, new)\\n                changed = True\\n        return changed\\n    \\n    def run_pipeline(self, max_iterations=5):\\n        \\\"\\\"\\\"运行完整管线\\\"\\\"\\\"\\n        print('=' * 50)\\n        print('AI文本自我审计管线 v1.0')\\n        print('来源: NeurIPS 2025 + humanizer-skill + humanize-text')\\n        print('=' * 50)\\n        \\n        for iteration in range(max_iterations):\\n            issues = self.audit()\\n            \\n            if not issues:\\n                print(f'\\\\n✅ 第{iteration+1}轮: 未发现问题，文本通过审计')\\n                break\\n            \\n            print(f'\\\\n第{iteration+1}轮: 发现{len(issues)}个问题')\\n            for name, count, _ in issues[:8]:\\n                print(f'  ⚠️  {name}: {count}处')\\n            \\n            # 修复\\n            fixed = False\\n            if self.fix_em_dashes():\\n                print('  ✅ 修复破折号')\\n                fixed = True\\n            if self.fix_template_connectors():\\n                print('  ✅ 修复模板化连接词')\\n                fixed = True\\n            if self.fix_absolutes():\\n                print('  ✅ 降低绝对化表达')\\n                fixed = True\\n            \\n            if not fixed:\\n                print('  ℹ️  无需修复或无法自动修复')\\n                break\\n        \\n        return self.text\\n\\n# 主函数\\nif __name__ == '__main__':\\n    # 读入文本\\n    path = r'C:\\\\Users\\\\27063\\\\Desktop\\\\工具箱\\\\论文降低aigc分析文献库\\\\v13_极碎裂版.txt'\\n    with open(path, 'r', encoding='utf-8') as f:\\n        text = f.read()\\n    \\n    pipeline = SelfAuditPipeline(text)\\n    result = pipeline.run_pipeline(max_iterations=5)\\n    \\n    # 统计\\n    cn_before = len(re.findall(r'[\\\\u4e00-\\\\u9fff]', text))\\n    cn_after = len(re.findall(r'[\\\\u4e00-\\\\u9fff]', result))\\n    \\n    sents = []\\n    for p in [l.strip() for l in result.strip().split('\\\\n') if len(l.strip())>15]:\\n        for s in re.split(r'[。！？；]', p):\\n            c = len(re.findall(r'[\\\\u4e00-\\\\u9fff]', s.strip()))\\n            if c >= 4: sents.append(c)\\n    avg = sum(sents)/len(sents) if sents else 0\\n    short = sum(1 for s in sents if s<15)/len(sents)*100 if sents else 0\\n    import math\\n    v = sum((s-avg)**2 for s in sents)/len(sents) if sents else 0\\n    cov = math.sqrt(v)/avg*100 if avg else 0\\n    \\n    print(f'\\\\n{\\\"=\\\"*50}')\\n    print(f'处理完成: {cn_before} → {cn_after}字')\\n    print(f'CoV: {cov:.1f}% 短句: {short:.1f}% 句长: {avg:.1f}')\\n    print(f'破折号: {result.count(chr(8212)*2)}')\\n    \\n    # 保存\\n    outpath = r'C:\\\\Users\\\\27063\\\\Desktop\\\\工具箱\\\\论文降低aigc分析文献库\\\\v14_自审计迭代版.txt'\\n    with open(outpath, 'w', encoding='utf-8') as f:\\n        f.write(result)\\n    \\n    import docx\\n    from docx.shared import Pt, Cm\\n    doc = docx.Document()\\n    for s in doc.sections:\\n        s.top_margin=Cm(2.54);s.bottom_margin=Cm(2.54);s.left_margin=Cm(3.17);s.right_margin=Cm(3.17)\\n    for p in [l.strip() for l in result.strip().split('\\\\n') if l.strip()]:\\n        para=doc.add_paragraph();para.add_run(p).font.size=Pt(12)\\n        para.paragraph_format.first_line_indent=Cm(0.74);para.paragraph_format.line_spacing=1.5\\n    docx_path = r'C:\\\\Users\\\\27063\\\\Desktop\\\\工具箱\\\\论文降低aigc分析文献库\\\\v14_自审计迭代版.docx'\\n    doc.save(docx_path)\\n    print(f'✅ v14自审计迭代版 已保存 拿去测')\\n\\\"\", \"path\": \"C:\\\\Users\\\\27063\\\\Desktop\\\\工具箱\\\\self_audit_pipeline.py\"}"}}],"reasoning_content":"The raw file is timing out. Let me try a different approach - look at the GitHub page for the humanizer-skill to understand the 43 patterns.\n\nActually, I found the core insight already. The most important project is the NeurIPS 2025 paper \"Adversarial Paraphrasing\" which shows that iterative refinement with detector feedback can make AI text undetectable. The key approach from the international projects is:\n\n**Multi-pass pipeline with self-audit** - check for AI patterns, fix them, re-check, repeat.\n\nLet me implement this using the patterns I've gathered from ALL my research. I'll create a self-auditing loop that:\n1. Checks text against all known AI patterns\n2. Fixes each pattern\n3. Re-checks\n4. Iterates until clean\n\nI have enough knowledge from 13 versions of testing to implement this."}
