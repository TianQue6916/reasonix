{"role":"assistant","content":"","tool_calls":[{"id":"call_00_svHWlauTbR5qsTu9NyiJ7845","type":"function","function":{"name":"write_file","arguments":"{\"path\": \"C:\\\\Users\\\\27063\\\\Desktop\\\\工具箱\\\\aigc-engine\\\\run.py\", \"content\": \"\\\"\\\"\\\"\\nAIGC引擎主入口 — 一键执行全流程\\n\\\"\\\"\\\"\\nimport re\\nimport sys\\nimport os\\n\\n# 添加当前目录到路径\\nsys.path.insert(0, os.path.dirname(__file__))\\n\\nfrom detector import AIGCDetector\\nfrom pipelines import run_all_pipelines\\nfrom loop import FeedbackLoop\\n\\n\\ndef main(input_path, output_path=None):\\n    # 读取输入\\n    with open(input_path, 'r', encoding='utf-8') as f:\\n        text = f.read()\\n    \\n    cn_before = len(re.findall(r'[\\\\u4e00-\\\\u9fff]', text))\\n    print(f'输入: {cn_before}字')\\n    print('=' * 50)\\n    \\n    # 1. 检测原始评分\\n    detector = AIGCDetector()\\n    initial_score = detector.analyze(text)\\n    print(f'原始AI评分: {initial_score:.1f}/100')\\n    \\n    # 2. 多管线处理\\n    print('\\\\n▶ 阶段1: 多管线并行处理')\\n    pipeline_results = run_all_pipelines(text)\\n    \\n    best_score = initial_score\\n    best_text = text\\n    \\n    for name, result in pipeline_results:\\n        score = detector.analyze(result)\\n        status = '✅' if score < initial_score else '❌'\\n        print(f'  {status} [{name}]: {score:.1f}/100')\\n        if score < best_score:\\n            best_score = score\\n            best_text = result\\n    \\n    # 3. 迭代反馈循环\\n    if best_score > 30:\\n        print(f'\\\\n▶ 阶段2: 迭代反馈循环 (当前最优:{best_score:.1f}, 目标:<30)')\\n        loop = FeedbackLoop(max_iterations=8, target_score=30)\\n        best_text = loop.optimize(best_text)\\n        best_score = detector.analyze(best_text)\\n    \\n    # 4. 最终评估\\n    print('\\\\n' + '=' * 50)\\n    cn_after = len(re.findall(r'[\\\\u4e00-\\\\u9fff]', best_text))\\n    print(f'最终AI评分: {best_score:.1f}/100')\\n    print(f'字数变化: {cn_before} → {cn_after}')\\n    \\n    level = 'PASS ✅' if best_score < 50 else 'HIGH 🔴' if best_score >= 70 else 'MEDIUM 🟠'\\n    print(f'结果判定: {level}')\\n    \\n    # 保存\\n    if output_path is None:\\n        output_path = os.path.join(os.path.dirname(__file__), 'output', 'v20_引擎输出.txt')\\n    \\n    os.makedirs(os.path.dirname(output_path), exist_ok=True)\\n    with open(output_path, 'w', encoding='utf-8') as f:\\n        f.write(best_text)\\n    \\n    # 同时导出Word\\n    try:\\n        from docx import Document\\n        from docx.shared import Pt, Cm\\n        doc = Document()\\n        for section in doc.sections:\\n            section.top_margin = Cm(2.54)\\n            section.bottom_margin = Cm(2.54)\\n            section.left_margin = Cm(3.17)\\n            section.right_margin = Cm(3.17)\\n        \\n        # 设置元数据\\n        cp = doc.core_properties\\n        cp.author = 'student'\\n        cp.title = '论文'\\n        cp.revision = 3\\n        \\n        for p in [l.strip() for l in best_text.strip().split('\\\\n') if l.strip()]:\\n            para = doc.add_paragraph()\\n            para.add_run(p).font.size = Pt(12)\\n            para.paragraph_format.first_line_indent = Cm(0.74)\\n            para.paragraph_format.line_spacing = 1.5\\n        \\n        docx_path = output_path.replace('.txt', '.docx')\\n        doc.save(docx_path)\\n        print(f'Word已保存: {docx_path}')\\n    except ImportError:\\n        print('python-docx不可用，仅保存txt')\\n    \\n    print(f'文本已保存: {output_path}')\\n    return best_text\\n\\n\\nif __name__ == '__main__':\\n    input_path = r'C:\\\\Users\\\\27063\\\\Desktop\\\\工具箱\\\\论文降低aigc分析文献库\\\\全球治理视域下的变局与共识_v3（v9.1策略）.txt'\\n    output_dir = os.path.join(os.path.dirname(__file__), 'output')\\n    os.makedirs(output_dir, exist_ok=True)\\n    output_path = os.path.join(output_dir, 'v20_引擎输出.txt')\\n    main(input_path, output_path)\\n\"}"}}],"reasoning_content":"Now the main entry point."}
