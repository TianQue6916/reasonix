{"role":"tool","tool_call_id":"call_00_kRj9oGedJBKLYQIqR2Qq9705","name":"run_command","content":"$ python -c \"\nimport re\n\npath = r'C:\\Users\\27063\\Desktop\\工具箱\\论文降低aigc分析文献库\\v13_极碎裂版.txt'\nwith open(path, 'r', encoding='utf-8') as f:\n    text = f.read()\n\ncn = len(re.findall(r'[\\u4e00-\\u9fff]', text))\n\n# 多轮自检修复循环\nfor iteration in range(5):\n    issues = []\n    \n    # 检查1: 破折号\n    dash_count = text.count('——')\n    if dash_count > 30:\n        issues.append(f'破折号{dash_count}个')\n        parts = text.split('——')\n        result = [parts[0]]\n        for i in range(1, len(parts)):\n            if i % 4 == 0:\n                result.append('——' + parts[i])\n            else:\n                result.append('，' + parts[i])\n        text = ''.join(result)\n    \n    # 检查2: 模板连接词\n    for old in ['综上所述', '总而言之', '总的来说', '毫无疑问', '显而易见', '毋庸置疑', '不言而喻']:\n        if old in text:\n            issues.append(f'{old}')\n            text = text.replace(old, '')\n    \n    # 检查3: 绝对化词\n    for old, new in [('必然', '很可能'), ('一定会', '大概率会'), ('必将', '有望'), ('绝对', '相当'), ('无一例外', '在绝大多数情况下')]:\n        if old in text:\n            issues.append(f'绝对化:{old}')\n            text = text.replace(old, new)\n    \n    # 检查4: 空洞大词\n    for w in ['具有重要意义', '发挥着重要作用', '前景广阔', '不可替代']:\n        if w in text:\n            issues.append(f'空洞:{w}')\n            text = text.replace(w, '')\n    \n    if not issues:\n        print(f'第{iteration+1}轮: ✅ 无问题')\n        break\n    else:\n        print(f'第{iteration+1}轮: 修复了{len(issues)}处: {issues[:5]}')\n    \n    if iteration == 4:\n        print('达到最大迭代次数')\n\n# 清理\ntext = re.sub(r'[。]{2,}', '。', text)\ncn = len(re.findall(r'[\\u4e00-\\u9fff]', text))\n\nsents = []\nfor p in [l.strip() for l in text.strip().split('\\n') if len(l.strip())>15]:\n    for s in re.split(r'[。！？；]', p):\n        c = len(re.findall(r'[\\u4e00-\\u9fff]', s.strip()))\n        if c >= 4: sents.append(c)\navg = sum(sents)/len(sents) if sents else 0\nshort = sum(1 for s in sents if s<15)/len(sents)*100 if sents else 0\nimport math\nv = sum((s-avg)**2 for s in sents)/len(sents) if sents else 0\ncov = math.sqrt(v)/avg*100 if avg else 0\n\nimport docx\nfrom docx.shared import Pt, Cm\ndoc = docx.Document()\nfor s in doc.sections:\n    s.top_margin=Cm(2.54);s.bottom_margin=Cm(2.54);s.left_margin=Cm(3.17);s.right_margin=Cm(3.17)\nfor p in [l.strip() for l in text.strip().split('\\n') if l.strip()]:\n    para=doc.add_paragraph();para.add_run(p).font.size=Pt(12)\n    para.paragraph_format.first_line_indent=Cm(0.74);para.paragraph_format.line_spacing=1.5\nout = r'C:\\Users\\27063\\Desktop\\工具箱\\论文降低aigc分析文献库\\v14_自审计迭代版.docx'\ndoc.save(out)\n\nprint(f'字数:{cn} CoV:{cov:.1f}% 短句:{short:.1f}% 破折号:{text.count(chr(8212)*2)}')\nprint('✅ v14 自审计迭代版 基于NeurIPS 2025 + humanizer-skill + humanize-text')\nprint('拿去测')\n\"\n[exit 0]\n第1轮: 修复了3处: ['破折号34个', '显而易见', '空洞:不可替代']\r\n第2轮: ✅ 无问题\r\n字数:8719 CoV:39.6% 短句:7.2% 破折号:8\r\n✅ v14 自审计迭代版 基于NeurIPS 2025 + humanizer-skill + humanize-text\r\n拿去测\r\n"}
