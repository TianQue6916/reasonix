{"role":"tool","tool_call_id":"call_00_8VkoqM8chirK9wP4ce6h9207","name":"run_command","content":"$ python -c \"\nimport re\n\n# 从v3原始版出发\npath = r'C:\\Users\\27063\\Desktop\\工具箱\\论文降低aigc分析文献库\\全球治理视域下的变局与共识_v3（v9.1策略）.txt'\nwith open(path,'r',encoding='utf-8') as f:\n    text = f.read()\n\ncn_before = len(re.findall(r'[\\u4e00-\\u9fff]', text))\n\n# ===== 终极替换规则全集 =====\n# 来源: humanize-chinese(126学术+200通用) + 知网高频词清单 + 70词替换表 + 万方替换词 + aigc-deslop\n\nrules = [\n    # === 学术模板 (知网高频) ===\n    ('本文旨在', '本研究想探讨的是'),\n    ('研究表明', '从已有的研究来看'),\n    ('具有重要意义', '是值得关注的'),\n    ('值得注意的是', '需要留意的一点是'),\n    ('综上所述', '把上面的分析梳理一下可以看到'),\n    ('总而言之', '总的来看'),\n    ('由此可见', '从这方面来看'),\n    ('不难发现', '可以看到'),\n    ('需要指出的是', '这里要补充一点'),\n    ('不仅如此', '不只是这样'),\n    ('与此同时', '在这段时期里'),\n    ('在此基础上', '在这个基础上'),\n    ('毫无疑问', '可以说'),\n    ('不可否认', '应当说'),\n    ('显而易见', '比较明显的是'),\n    ('更重要的是', '更值得关注的是'),\n    ('换言之', '换句话讲'),\n    ('具体而言', '具体来说'),\n    ('此外', '除了这些之外'),\n    ('进而', '在此基础上'),\n    ('从而', '这样就'),\n    ('基于此', '出于这个考虑'),\n    ('总的来说', '大体上看'),\n    # === 连接词替换 ===\n    ('因此', '所以说'),\n    ('而且', '同时'),\n    ('因为', '主要是由于'),\n    ('所以', '因此可以说'),\n    ('如果', '要是'),\n    ('首先', '第一点'),\n    ('其次', '第二点'),\n    ('最后', '第三点'),\n    # === 高频词替换（70词表+知网）===\n    ('重要', '关键'),\n    ('方式', '办法'),\n    ('方面', '角度'),\n    ('特点', '特征'),\n    ('方法', '思路'),\n    ('过程', '经过'),\n    ('结果', '结果来看'),\n    ('条件', '前提'),\n    ('作用', '影响'),\n    ('内容', '要点'),\n    ('程度', '幅度'),\n    ('原因', '来源'),\n    ('目标', '方向'),\n    ('水平', '程度'),\n    ('范围', '覆盖面'),\n    ('趋势', '走向'),\n    ('能力', '本事'),\n    ('优势', '长处'),\n    ('资源', '条件'),\n    ('环境', '氛围'),\n    ('系统', '体系'),\n    ('关注', '留意'),\n    ('涉及', '牵扯到'),\n    ('依据', '根据'),\n    ('目前', '现阶段'),\n    ('通过', '借助'),\n    ('根据', '按照'),\n    ('完全', '彻底'),\n    ('不断', '持续'),\n    ('逐渐', '逐步'),\n    ('主要', '核心'),\n    ('一般', '通常'),\n    ('大量', '大批'),\n    ('进一步', '更深层'),\n    ('充分', '充足'),\n    ('特别', '格外'),\n    ('可能', '或许'),\n    ('显著', '突出'),\n    ('广泛', '普遍'),\n    ('日益', '日渐'),\n    ('逐步', '渐渐'),\n    # === aigc-deslop 实践经验 ===\n    ('深刻揭示', '深入呈现'),\n    ('综合运用', '综合采用'),\n    ('扮演着', '发挥着'),\n    ('对于', '就'),\n    ('非常', '十分'),\n    ('很多', '不少'),\n    ('非常', '相当'),\n]\n\n# 长key优先\nrules.sort(key=lambda x: len(x[0]), reverse=True)\n\ncount = 0\nfor old, new in rules:\n    if old in text:\n        text = text.replace(old, new)\n        count += 1\n\ntext = re.sub(r'[。]{2,}', '。', text)\ncn_after = len(re.findall(r'[\\u4e00-\\u9fff]', text))\n\n# 统计\nsents = []\nfor p in [l.strip() for l in text.strip().split('\\n') if len(l.strip())>10]:\n    for s in re.split(r'[。！？；\\n]', p):\n        c = len(re.findall(r'[\\u4e00-\\u9fff]', s.strip()))\n        if c >= 4: sents.append(c)\navg = sum(sents)/len(sents) if sents else 0\nshort = sum(1 for s in sents if s<15)/len(sents)*100 if sents else 0\nimport math\nv = sum((s-avg)**2 for s in sents)/len(sents) if sents else 0\ncov = math.sqrt(v)/avg*100 if avg else 0\n\nprint(f'替换{count}处 | {cn_before}→{cn_after}字 | CoV:{cov:.1f}% | 短句:{short:.1f}%')\n\nimport docx\nfrom docx.shared import Pt, Cm\ndoc = docx.Document()\nfor s in doc.sections:\n    s.top_margin=Cm(2.54);s.bottom_margin=Cm(2.54);s.left_margin=Cm(3.17);s.right_margin=Cm(3.17)\nfor p in [l.strip() for l in text.strip().split('\\n') if l.strip()]:\n    para=doc.add_paragraph();para.add_run(p).font.size=Pt(12)\n    para.paragraph_format.first_line_indent=Cm(0.74);para.paragraph_format.line_spacing=1.5\ndoc.save(r'C:\\Users\\27063\\Desktop\\工具箱\\论文降低aigc分析文献库\\v15_终级替换版.docx')\nprint('✅ v15 终级替换版 拿去测')\n\"\n[exit 0]\n替换38处 | 10001→10009字 | CoV:63.2% | 短句:31.3%\r\n✅ v15 终级替换版 拿去测\r\n"}
