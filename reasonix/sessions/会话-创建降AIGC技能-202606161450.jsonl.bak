acing = 1.5\nout = r'C:\\Users\\27063\\Desktop\\工具箱\\论文降低aigc分析文献库\\v7_口语正式版.docx'\ndoc.save(out)\n\nprint(f'字数:{cn} 句长:{avg:.1f} 短句:{short:.1f}% CoV:{cov:.1f}%')\nif cn >= 10000: print('✅ 已保存')\nelse: print(f'差{10000-cn}字')\n\"\n[exit 0]\n字数:6937 句长:30.0 短句:6.5% CoV:36.2%\r\n差3063字\r\n"}
