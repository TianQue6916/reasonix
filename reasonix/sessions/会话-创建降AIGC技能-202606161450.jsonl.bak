研究显示': '已有数据呈现',\\n    '研究指出': '已有文献明确',\\n    '结果显示': '结果反映',\\n    '结果表明': '结果印证',\\n    '实验表明': '实验得出',\\n    '数据显示': '数据反映',\\n    '数据表明': '数据指向',\\n    '可能需要': '或许得',\\n    '可以通过': '借助',\\n    '取决于': '要看',\\n    '通常情况下': '多数情况里',\\n    '整个': '全部',\\n    '不同': '各种',\\n    '重要': '关键',\\n    '方式': '办法',\\n    '通过': '借助',\\n    '同时': '另外',\\n    '而且': '并且',\\n    '所以': '因而',\\n    '因为': '由于',\\n    '如果': '假如',\\n    '为了': '为',\\n}\\n\\ndef apply_replacements(text, rep_dict, allow_partial=False):\\n    \\\"\\\"\\\"应用替换字典，长key优先\\\"\\\"\\\"\\n    items = sorted(rep_dict.items(), key=lambda x: len(x[0]), reverse=True)\\n    for old, new in items:\\n        # 确保不是子串匹配（防止\\\"因此\\\"被替换成\\\"故\\\"后\\\"因为\\\"变成另一个）\\n        if allow_partial:\\n            text = text.replace(old, new)\\n        else:\\n            # 只在独立词位置替换\\n            text = re.sub(re.escape(old), new, text)\\n    return text\\n\\n# 应用所有替换\\ntext = apply_replacements(text, academic_reps)\\ntext = apply_replacements(text, general_reps)\\n\\n# ========== 第三阶段：句式处理 ==========\\n# 降低破折号密度（humanize-chinese指出em-dash密度>1%是AI特征）\\ndash_count = text.count('——')\\nif dash_count > 50:  # 太多了\\n    # 部分破折号改为逗号或句号\\n    import random\\n    parts = text.split('——')\\n    new_parts = [parts[0]]\\n    for i in range(1, len(parts)):\\n        if i % 3 == 0:  # 每3个保留1个\\n            new_parts.append('——' + parts[i])\\n        else:\\n            new_parts.append('，' + parts[i])\\n    text = ''.join(new_parts)\\n\\n# 清理\\ntext = re.sub(r'[。]{2,}', '。', text)\\ntext = re.sub(r'[，]{2,}', '，', text)\\ntext = re.sub(r'[、]{2,}', '、', text)\\ntext = re.sub(r'\\\\s{2,}', '\\\\n', text)\\n\\n# ========== 检测效果 ==========\\ncn = len(re.findall(r'[\\\\u4e00-\\\\u9fff]', text))\\nremaining_dash = text.count('——')\\nprint(f'原始字数: {original_cn}')\\nprint(f'处理后字数: {cn}')\\nprint(f'破折号数: {remaining_dash}')\\n\\n# 连接词检测\\nconn = ['因此','然而','但是','此外','同时','而且','并且','所以','因为','由于','虽然','尽管','但','故','从而','进而']\\ntotal = sum(text.count(c) for c in conn)\\nfor c in conn:\\n    cnt = text.count(c)\\n    if cnt>0: print(f'  {c}: {cnt}')\\nprint(f'连接词总计: {total}')\\n\\n# 保存\\nout_path = r'C:\\\\Users\\\\27063\\\\Desktop\\\\工具箱\\\\论文降低aigc分析文献库\\\\全球治理视域下的变局与共识_v4（确定性替换版）.txt'\\nwith open(out_path,'w',encoding='utf-8') as f:\\n    f.write(text)\\nprint(f'已保存: {out_path}')\\n\", \"path\": \"deterministic_replace.py\"}"}}],"reasoning_content":"Now I have the complete humanize-chinese pattern file and ngram model. The key insight I was missing is this:\n\n1. The tool has a HUGE pattern database (patterns_cn.json) with 200+ replacement pairs, including academic-specific replacements (120+ entries)\n2. Core strategies: detect → replace → restructure → noise inject\n3. It uses n-gram perplexity and burstiness to guide the rewriting\n4. The academic mode specifically targets 知网/维普 patterns\n\nI can now create a comprehensive Python script that uses the same approach:\n1. Use all the replacements from patterns_cn.json\n2. Use the academic-specific replacement table\n3. Apply the multi-strategy approach\n\nLet me write a script that applies ALL the replacement rules from patterns_cn.json to the paper."}
