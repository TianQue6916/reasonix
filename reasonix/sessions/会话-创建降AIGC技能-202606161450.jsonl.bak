{"role":"assistant","content":"","tool_calls":[{"id":"call_00_pvbVYTsK2Y0qRsEYxdZT5376","type":"function","function":{"name":"write_file","arguments":"{\"path\": \"C:\\\\Users\\\\27063\\\\Desktop\\\\工具箱\\\\aigc-engine\\\\detector.py\", \"content\": \"\\\"\\\"\\\"\\n本地统计检测器 — 多维文本特征分析\\n输出: 综合AI疑似度评分 0-100\\n特征维度: n-gram频率 | 句长分布 | 词汇多样性 | 标点模式 | AI高频词密度 | 段落结构\\n\\\"\\\"\\\"\\n\\nimport re\\nimport math\\nimport json\\nfrom collections import Counter\\n\\nclass AIGCDetector:\\n    def __init__(self):\\n        self.scores = {}\\n        \\n    def analyze(self, text):\\n        \\\"\\\"\\\"全维度分析，返回综合评分0-100\\\"\\\"\\\"\\n        cn = len(re.findall(r'[\\\\u4e00-\\\\u9fff]', text))\\n        if cn < 50:\\n            return 50  # 太短无法判断\\n        \\n        results = {}\\n        \\n        # 1. n-gram频率分析 (权重25%)\\n        results['ngram'] = self._score_ngram(text)\\n        \\n        # 2. 句长分布分析 (权重20%)\\n        results['sentence_length'] = self._score_sentence_length(text)\\n        \\n        # 3. 词汇多样性 (权重15%)\\n        results['vocabulary'] = self._score_vocabulary(text)\\n        \\n        # 4. 标点模式 (权重10%)\\n        results['punctuation'] = self._score_punctuation(text)\\n        \\n        # 5. AI高频词密度 (权重20%)\\n        results['ai_words'] = self._score_ai_words(text)\\n        \\n        # 6. 段落结构 (权重10%)\\n        results['paragraph'] = self._score_paragraph(text)\\n        \\n        # 加权综合\\n        weights = {\\n            'ngram': 0.25,\\n            'sentence_length': 0.20,\\n            'vocabulary': 0.15,\\n            'punctuation': 0.10,\\n            'ai_words': 0.20,\\n            'paragraph': 0.10\\n        }\\n        \\n        total = sum(results[k] * weights[k] for k in weights)\\n        total = min(100, max(0, total))\\n        \\n        self.scores = results\\n        self.total = total\\n        \\n        return total\\n    \\n    def get_report(self, text):\\n        \\\"\\\"\\\"返回详细检测报告\\\"\\\"\\\"\\n        self.analyze(text)\\n        report = {\\n            'total': self.total,\\n            'details': self.scores,\\n            'level': self._level(self.total),\\n            'flags': self._get_flags(text)\\n        }\\n        return report\\n    \\n    def _level(self, score):\\n        if score >= 70: return '🔴 HIGH'\\n        if score >= 50: return '🟠 MEDIUM'\\n        if score >= 30: return '🟣 LOW'\\n        return '⚫ PASS'\\n    \\n    def _score_ngram(self, text, window=3):\\n        \\\"\\\"\\\"基于n-gram频率分布检测AI模式\\\"\\\"\\\"\\n        chars = re.findall(r'[\\\\u4e00-\\\\u9fff]', text)\\n        if len(chars) < 100:\\n            return 50\\n        \\n        ngrams = [''.join(chars[i:i+window]) for i in range(len(chars)-window+1)]\\n        \\n        # AI文本的n-gram分布更集中（重复率高）\\n        freq = Counter(ngrams)\\n        top_10_ratio = sum(v for _, v in freq.most_common(10)) / len(ngrams)\\n        \\n        # 人类文本top-10占比通常<0.05，AI文本>0.08\\n        if top_10_ratio > 0.10: return 85\\n        if top_10_ratio > 0.08: return 70\\n        if top_10_ratio > 0.06: return 55\\n        if top_10_ratio > 0.04: return 40\\n        return 25\\n    \\n    def _score_sentence_length(self, text):\\n        \\\"\\\"\\\"句长分布分析\\\"\\\"\\\"\\n        sents = []\\n        for p in text.split('\\\\n'):\\n            for s in re.split(r'[。！？；]', p):\\n                c = len(re.findall(r'[\\\\u4e00-\\\\u9fff]', s.strip()))\\n                if c >= 4: sents.append(c)\\n        \\n        if len(sents) < 5: return 50\\n        \\n        avg = sum(sents) / len(sents)\\n        std = math.sqrt(sum((s-avg)**2 for s in sents) / len(sents))\\n        cov = std / avg * 100 if avg > 0 else 0\\n        short_ratio = sum(1 for s in sents if s < 15) / len(sents) * 100\\n        \\n        # AI文本特征: CoV<40, 短句<10%\\n        score = 0\\n        if cov < 35: score += 40\\n        elif cov < 45: score += 30\\n        elif cov < 55: score += 20\\n        else: score += 10\\n        \\n        if short_ratio < 5: score += 30\\n        elif short_ratio < 12: score += 20\\n        elif short_ratio < 20: score += 15\\n        else: score += 10\\n        \\n        # 检查连续3句长度相近\\n        uniform_count = 0\\n        for i in range(len(sents)-2):\\n            if abs(sents[i]-sents[i+1])<5 and abs(sents[i+1]-sents[i+2])<5:\\n                uniform_count += 1\\n        if uniform_count > len(sents) * 0.3: score += 15\\n        \\n        return min(95, max(5, score))\\n    \\n    def _score_vocabulary(self, text):\\n        \\\"\\\"\\\"词汇多样性分析\\\"\\\"\\\"\\n        words = re.findall(r'[\\\\u4e00-\\\\u9fff]{2,4}', text)\\n        if len(words) < 20: return 50\\n        \\n        unique = len(set(words))\\n        ttr = unique / len(words)  # Type-Token Ratio\\n        \\n        # AI文本TTR偏低（词汇重复多）\\n        if ttr < 0.25: return 80\\n        if ttr < 0.30: return 65\\n        if ttr < 0.35: return 50\\n        if ttr < 0.40: return 40\\n        return 25\\n    \\n    def _score_punctuation(self, text):\\n        \\\"\\\"\\\"标点模式分析\\\"\\\"\\\"\\n        cn = len(re.findall(r'[\\\\u4e00-\\\\u9fff]', text))\\n        if cn < 50: return 50\\n        \\n        periods = text.count('。')\\n        commas = text.count('，')\\n        dashes = text.count('——') // 2\\n        semis = text.count('；')\\n        \\n        score = 20  # 基础分\\n        \\n        # 破折号过多\\n        if dashes > cn * 0.01: score += 25\\n        elif dashes > cn * 0.005: score += 15\\n        \\n        # 句号/逗号比例\\n        if periods > 0:\\n            ratio = commas / periods\\n            if ratio < 1.0: score += 20  # 逗号太少，AI特征\\n            elif ratio > 5.0: score += 10\\n            else: score += 5\\n        \\n        # 分号\\n        semis_per_1000 = semis / cn * 1000\\n        if semis_per_1000 > 5: score += 15\\n        \\n        return min(90, max(10, score))\\n    \\n    def _score_ai_words(self, text):\\n        \\\"\\\"\\\"AI高频词密度分析\\\"\\\"\\\"\\n        ai_phrases = [\\n            '值得注意的是', '综上所述', '总而言之', '由此可见', '不难发现',\\n            '具有重要意义', '发挥着重要作用', '产生了深远影响', \\n            '不可否认', '毫无疑问', '显而易见', '毋庸置疑',\\n            '在此基础上', '与此同时', '不仅如此', '换句话说',\\n            '具体而言', '进一步说', '基于此', '鉴于此',\\n            '近年来', '目前', '现阶段', '当前',\\n            '研究表明', '本文旨在', '本研究发现',\\n            '有效', '显著', '充分', '广泛',\\n            '导致', '引起', '造成',\\n            '越来越多的', '日益', '逐步',\\n            '问题', '挑战', '困境',\\n            '机制', '体系', '系统',\\n            '实现', '建立', '构建',\\n            '提升', '增强', '改善',\\n            '促进', '推动', '推进',\\n        ]\\n        \\n        cn = len(re.findall(r'[\\\\u4e00-\\\\u9fff]', text))\\n        if cn == 0: return 50\\n        \\n        matches = sum(text.count(p) for p in ai_phrases)\\n        density = matches / cn * 1000  # 每千字出现次数\\n        \\n        if density > 15: return 85\\n        if density > 10: return 70\\n        if density > 6: return 55\\n        if density > 3: return 40\\n        return 25\\n    \\n    def _score_paragraph(self, text):\\n        \\\"\\\"\\\"段落结构分析\\\"\\\"\\\"\\n        paras = [p.strip() for p in text.split('\\\\n') if len(p.strip()) > 20]\\n        if len(paras) < 3: return 50\\n        \\n        # 段落长度分布\\n        lengths = [len(re.findall(r'[\\\\u4e00-\\\\u9fff]', p)) for p in paras]\\n        avg = sum(lengths) / len(lengths)\\n        std = math.sqrt(sum((l-avg)**2 for l in lengths) / len(lengths))\\n        cv = std / avg * 100 if avg > 0 else 0\\n        \\n        score = 30\\n        if cv < 30: score += 30  # 段落长度太均匀\\n        elif cv < 50: score += 20\\n        \\n        # 段落开头重复率\\n        openings = [p[:15] for p in paras]\\n        unique_openings = len(set(openings))\\n        if unique_openings < len(paras) * 0.5: score += 20\\n        \\n        return min(85, max(15, score))\\n    \\n    def _get_flags(self, text):\\n        \\\"\\\"\\\"返回具体问题标记\\\"\\\"\\\"\\n        flags = []\\n        \\n        # 句长检查\\n        sents = []\\n        for p in text.split('\\\\n'):\\n            for s in re.split(r'[。！？；]', p):\\n                c = len(re.findall(r'[\\\\u4e00-\\\\u9fff]', s.strip()))\\n                if c >= 4: sents.append(c)\\n        if sents:\\n            std = math.sqrt(sum((s-sum(sents)/len(sents))**2 for s in sents)/len(sents))\\n            if std < 8: flags.append('句长过于均匀')\\n        \\n        # 检查三个连续相似句\\n        for i in range(len(sents)-2):\\n            if abs(sents[i]-sents[i+1])<5 and abs(sents[i+1]-sents[i+2])<5:\\n                flags.append('存在连续相似长度句子')\\n                break\\n        \\n        # AI短语检查\\n        for phrase in ['综上所述', '值得注意的是', '具有重要意义']:\\n            if phrase in text: flags.append(f'AI模板词: {phrase}')\\n        \\n        # 破折号检查\\n        if text.count('——') > 30: flags.append('破折号过多')\\n        \\n        return flags[:5]\\n\\n\\nif __name__ == '__main__':\\n    import sys\\n    path = sys.argv[1] if len(sys.argv) > 1 else r'C:\\\\Users\\\\27063\\\\Desktop\\\\工具箱\\\\论文降低aigc分析文献库\\\\全球治理视域下的变局与共识_v3（v9.1策略）.txt'\\n    with open(path, 'r', encoding='utf-8') as f:\\n        text = f.read()\\n    \\n    d = AIGCDetector()\\n    r = d.get_report(text)\\n    print(f'综合评分: {r[\\\\\\\"total\\\\\\\"]:.1f}/100 — {r[\\\\\\\"level\\\\\\\"]}')\\n    print('维度细项:')\\n    for k, v in r['details'].items():\\n        print(f'  {k}: {v:.1f}')\\n    if r['flags']:\\n        print('问题标记:')\\n        for f in r['flags']:\\n            print(f'  ⚠️ {f}')\\n\"}"}}],"reasoning_content":"Now let me write all the files. Let me create them in order."}
