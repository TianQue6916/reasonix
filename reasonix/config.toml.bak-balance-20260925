# Reasonix configuration.
# Resolution order: flag > ./reasonix.toml > ~/AppData/Roaming/reasonix/config.toml > built-in defaults.
# Fields marked user/global only are not overridden by ./reasonix.toml.
# Secrets are named via api_key_env and stored in Reasonix's global .env; never put keys here.

config_version = 10   # schema marker for diagnostics; old versions may ignore it
default_model = "commandcode-goat/deepseek/deepseek-v4.1-flash"
language      = "zh"   # ui/model language; empty = auto-detect from $LANG / $REASONIX_LANG
credentials_store = "auto"   # legacy compatibility; provider keys are saved in Reasonix's global .env

[ui]
theme = "auto"   # auto|dark|light; CLI colors only; REASONIX_THEME can override per run
# theme_style = "graphite"   # graphite|aurora|slate|carbon|nocturne|amber and legacy aliases
# shortcut_layout = "desktop"   # classic|desktop; compatibility setting; Shift+Tab cycles read-only/workspace/YOLO/plan; Ctrl+Y toggles YOLO
# cursor_shape = "bar"   # block|underline|bar; text input cursor shape
# show_reasoning = true   # CLI: show thinking text by default; false = collapsed (toggle with Ctrl+O)
show_turn_usage = true   # CLI/TUI: show per-request token and cost receipts in the transcript

[desktop]
language = "zh"   # desktop UI language; empty/auto = browser/OS auto-detect
currency = "CNY"   # legacy display currency; prefer [billing].display_currency
layout_style = "workbench"   # desktop layout: workbench|creation; legacy classic migrates to workbench
theme = "auto"   # desktop only: auto|dark|light
terminal_theme = "auto"   # integrated terminal: auto|dark|light; auto follows the desktop app
theme_style = "slate"   # desktop accent palette
# external_opener = "vscode"   # desktop Open control: installed application id
close_behavior = "background"   # desktop: quit|background when the window close button is clicked
status_bar_style = "text"   # desktop: icon|text metric labels in the bottom status bar
status_bar_style_initialized = true   # icon default upgrade applied; preserve later user choices
status_bar_items = ["model", "workspace", "git_branch", "cache", "cache_avg", "session_tokens", "turn_tokens", "turn_cost", "session_turns", "context", "compact", "cost", "balance", "turn_tps", "turn_output_tokens", "turn_cache_tokens"]   # desktop: ordered visible bottom status bar items
default_tool_approval_mode = "danger-full-access"   # desktop: read-only/workspace-write/danger-full-access default for new sessions
check_updates = false   # desktop: check for new versions on startup
telemetry = true   # desktop: anonymous launch ping + scrubbed next-launch native crash diagnostics; never content
metrics = true   # desktop: aggregate quality/lifecycle metrics (anonymous signal/bucket counts); never content
provider_access = ["commandcode-goat"]   # desktop settings: providers shown on Settings > Model > Access
session_experience = "standard"   # desktop: standard|deep transcript experience
expand_thinking = true   # desktop: legacy reasoning display alias; use reasoning_display_mode
reasoning_display_mode = "auto"   # desktop: hidden|summary|auto|expanded reasoning presentation
display_mode = "standard"   # desktop: standard|compact transcript display mode

[billing]
display_currency = "CNY"   # auto|CNY|USD; display only — does not rewrite provider list prices

[telemetry]
cli_metrics = "auto"   # CLI content-free usage metrics: auto|on|off; auto requires a local interactive terminal

[notifications]
enabled = false   # system notifications for CLI and desktop turns; default off
turn_done = true   # notify when a turn finishes
approval_request = true   # notify when a tool approval is waiting
ask_request = true   # notify when a question is waiting

[network]
proxy_mode = "auto"   # auto|env|custom|off; auto currently uses env proxy
# proxy_url  = "socks5://127.0.0.1:7890"   # optional custom override
# no_proxy   = "localhost,127.0.0.1,.local"   # honored for proxy_mode = "custom"

[network.proxy]
type = "socks5"   # http|https|socks5|socks5h
# server = "127.0.0.1"
# port = 7890
# username = ""
# password = "${REASONIX_PROXY_PASSWORD}"   # optional; supports ${VAR} expansion

[environment]
enabled = true   # inject a stable startup environment summary into the model prompt
offline = false   # declare that outbound network access is unavailable; prevents futile retries
# [environment.tools]
# go = "/opt/homebrew/bin/go"   # trusted executable path; workspace-local paths are not auto-executed

[agent]
# system_prompt = """..."""   # omit to use the built-in prompt for this version
# system_prompt_file = "prompts/system.md"   # project paths stay in <workspace>; user paths may fall back to <reasonix home>
temperature       = 0.0
reasoning_language = "zh"   # visible reasoning language: auto|zh|en
compact_ratio       = 0.7   # sole auto trigger; presets 0.70/0.80/0.85 (default 0.80)
# keep                = ["errors"]   # deprecated compatibility field; ignored at runtime
# recent_keep         = 2   # deprecated compatibility field; ignored at runtime
# plan_mode_read_only_commands = ["gh issue view"]   # legacy compatibility only; Plan bash uses Permissions
# planner_model = "deepseek-pro"   # optional: enable two-model collaboration
vision_model = "commandcode-goat/deepseek/deepseek-v4.1-flash"   # image understanding fallback: auto or provider/model
# subagent_model = "deepseek-pro"   # optional default for runAs=subagent skills
# subagent_models = { review = "deepseek-pro", security_review = "deepseek-pro" }   # per-skill overrides
# subagent_effort = "high"   # optional default effort for subagents
# subagent_efforts = { review = "max", task = "high" }   # per-tool/skill effort overrides
# max_subagent_depth = 2   # nested subagent delegation depth; set 1 to disable nested delegation
max_subagent_concurrency = 32   # session-wide sub-agent concurrency (task/fleet/skills)
max_parallel_writers = 32   # concurrent writers with non-overlapping write_paths
# output_style = "explanatory"   # explanatory | learning | concise | custom; empty = default

[[providers]]
name        = "deepseek"
kind        = "openai"
base_url    = "https://api.deepseek.com"
models      = ["deepseek-v4-flash", "deepseek-v4-pro", "deepseek-v4-flash-vision-exp"]
default     = "deepseek-v4-flash"
api_key_env = "DEEPSEEK_API_KEY"
balance_url = "https://api.deepseek.com/user/balance"   # optional; wallet-balance endpoint shown in the status bar
context_window = 1000000   # tokens; compaction triggers near this limit
# max_output_tokens = 0       # recommended: official DeepSeek omits the field (server 384K ceiling)
# max_output_tokens = 32768   # optional cost cap
# max_output_tokens = 65536   # optional cost cap
# max_output_tokens = 131072  # optional cost cap
price       = { cache_hit = 0.02, input = 1, output = 2, currency = "¥" }   # provider-wide fallback, per 1M tokens
prices      = { "deepseek-v4-flash" = { cache_hit = 0.1, input = 3, output = 9, currency = "¥" }, "deepseek-v4-flash-vision-exp" = { cache_hit = 0.1, input = 3, output = 9, currency = "¥" }, "deepseek-v4-pro" = { cache_hit = 0.3, input = 9, output = 27, currency = "¥" } }   # per-model prices, per 1M tokens
billing_currency = "CNY"   # frozen list-price currency; independent of display_currency
thinking    = "enabled"
vision_models = ["deepseek-v4-flash-vision-exp"]   # models in this provider that accept image input
web_search  = false   # independent web_search tool; omitted defaults on for supported official DeepSeek APIs
model_overrides   = { "deepseek-v4-flash" = { supported_efforts = ["disabled", "low", "high", "max"], default_effort = "high" }, "deepseek-v4-flash-vision-exp" = { supported_efforts = ["disabled", "low", "high", "max"], default_effort = "high" }, "deepseek-v4-pro" = { supported_efforts = ["disabled", "high", "max"], default_effort = "high" } }   # per-model context/output/reasoning/vision overrides for mixed gateways

