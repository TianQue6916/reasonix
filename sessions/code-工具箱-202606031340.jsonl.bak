or\\\",\\n          \\\"description\\\": \\\"操作词颜色（控制流关键字: if/else/while/for 等）\\\"\\n        },\\n        \\\"mind.entityColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#9CDCFE\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"实体/变量颜色（变量引用、名词）\\\"\\n        },\\n        \\\"mind.functionColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#4EC9B0\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"函数调用颜色（C/Python 函数调用）\\\"\\n        },\\n        \\\"mind.typeColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#4FC1FF\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"类型关键字颜色（int/float/void/struct 等）\\\"\\n        },\\n        \\\"mind.numberColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#B5CEA8\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"数字/常量颜色\\\"\\n        },\\n        \\\"mind.stringColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#CE9178\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"字符串颜色\\\"\\n        },\\n        \\\"mind.naturalColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#CE9178\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"自然语言描述颜色\\\"\\n        },\\n        \\\"mind.commentColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#6A9955\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"注释颜色\\\"\\n        },\\n        \\\"mind.operatorColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#D4D4D4\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"运算符颜色\\\"\\n        },\\n       