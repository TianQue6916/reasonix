  \\\"grammars\\\": [\\n      {\\n        \\\"language\\\": \\\"mind\\\",\\n        \\\"scopeName\\\": \\\"source.mind\\\",\\n        \\\"path\\\": \\\"./syntaxes/mind.tmLanguage.json\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"title\\\": \\\"Mind Language\\\",\\n      \\\"properties\\\": {\\n        \\\"mind.actionColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#569CD6\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"操作词颜色（控制流关键字: if/else/while/for 等）\\\"\\n        },\\n        \\\"mind.entityColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#9CDCFE\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"实体/变量颜色（变量引用、名词）\\\"\\n        },\\n        \\\"mind.functionColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#4EC9B0\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"函数调用颜色（C/Python 函数调用）\\\"\\n        },\\n        \\\"mind.typeColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#4FC1FF\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"类型关键字颜色（int/float/void/struct 等）\\\"\\n        },\\n        \\\"mind.numberColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#B5CEA8\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"数字/常量颜色\\\"\\n        },\\n        \\\"mind.stringColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#CE9178\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"字符串颜色\\\"\\n        },\\n        \\\"mind.naturalColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#CE9178\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"自然语言描述颜色\\\"\\n        },\\n        \\\"mind.commentColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#6A9955\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"注释颜色\\\"\\n        },\\n        \\\"mind.operatorColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#D4D4D4\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"运算符颜色\\\"\\n        },\\n        \\\"mind.errorColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#F44747\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"逻辑错误下划线颜色\\\"\\n        },\\n        \\\"mind.warningColor\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"default\\\": \\\"#6A9955\\\",\\n          \\\"format\\\": \\\"color\\\",\\n          \\\"description\\\": \\\"不理解/警告下划线颜色\\\"\\n        },\\n        \\\"mind.indentColors\\\": {\\n          \\\"type\\\": \\\"array\\\",\\n          \\\"items\\\": {\\n            \\\"type\\\": \\\"string\\\"\\n          },\\n          \\\"default\\\": [\\\"#3A3D41\\\", \\\"#4A4D51\\\", \\\"#5A5D61\\\", \\\"#6A6D71\\\", \\\"#7A7D81\\\"],\\n          \\\"description\\\": \\\"缩进线颜色列表（按层级，第1层索引0，第2层索引1，以此类推）\\\"\\n        },\\n        \\\"mind.enableIndentLines\\\": {\\n          \\\"type\\\": \\\"boolean\\\",\\n          \\\"default\\\": true,\\n          \\\"description\\\": \\\"是否显示缩进关系线\\\"\\n        },\\n        \\\"mind.enableHoverHighlight\\\": {\\n          \\\"type\\\": \\\"boolean\\\",\\n          \\\"default\\\": true,\\n          \\\"description\\\": \\\"是否启用悬停引用高亮（悬停实体时灰色高亮所有同义词）\\\"\\n        },\\n        \\\"mind.enableDiagnostics\\\": {\\n          \\\"type\\\": \\\"boolean\\\",\\n          \\\"default\\\": true,\\n          \\\"description\\\": \\\"是否启用逻辑错误诊断（红色=错误，绿色=不理解）\\\"\\n        },\\n        \\\"mind.analysisDebounce\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"def